{
  "manifest_version": 3,
  "name": "GCal Time Tracker Helper",
  "version": "1.0.0",
  "description": "Quick-create time tracking events on Google Calendar",
  "homepage_url": "https://github.com/allenjhyang/gcal-time-tracker-helper",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://calendar.google.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://calendar.google.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ]
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["icons/icon16.png"],
      "matches": ["https://calendar.google.com/*"]
    }
  ]
}
